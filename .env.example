# Recommended (server-side only): paste your OpenAI key in OPENAI_API_KEY= so Vite dev/preview
# and VPS nginx /api/openai/chat proxy inject Authorization without baking secrets into client JS.
OPENAI_API_KEY=

# Optional (client-side static build): only set VITE_OPENAI_API_KEY= if intentionally embedding
# a key in the frontend bundle; leave empty in production to avoid exposing secrets in dist/*.js.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
